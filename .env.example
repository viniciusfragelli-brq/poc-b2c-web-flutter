# =============================================================================
# POC Login — configuração única
# =============================================================================
# Copie este arquivo para `.env` na raiz do projeto e preencha o que estiver
# marcado como <PREENCHER>. O `.env` está no .gitignore e nunca deve ser
# versionado.
#
# Não sabe de onde tirar estes valores? Rode a skill:  /poc-login-credenciais
# Ela explica como criar cada um no portal e preenche este arquivo para você.
#
# Nenhum destes valores é secreto: client id e tenant id são identificadores
# públicos, que aparecem na própria URL de login. Não há client secret nesta
# POC — o fluxo é authorization code + PKCE, que existe justamente para
# dispensar segredo em cliente público.
# =============================================================================


# -----------------------------------------------------------------------------
# SPA — o Vite lê apenas as variáveis com prefixo VITE_
# -----------------------------------------------------------------------------

# Qual IdP:  entra | b2c | external
#   entra    → tenant de workforce (funcionário, identidade corporativa)
#   b2c      → Azure AD B2C (login de cliente final)
#   external → Microsoft Entra External ID, sucessor do B2C
VITE_IDP=entra

# Application (client) ID do App Registration.
# Portal → sua aplicação → Visão geral → "ID do aplicativo (cliente)"
VITE_CLIENT_ID=<PREENCHER>

# Directory (tenant) ID. Só para VITE_IDP=entra.
# Portal → sua aplicação → Visão geral → "ID do diretório (locatário)"
VITE_TENANT_ID=<PREENCHER>

# Redirect URI. Tem que ser IDÊNTICO ao cadastrado no App Registration, na
# plataforma "Aplicativo de página única (SPA)" — barra final inclusa.
VITE_REDIRECT_URI=http://localhost:5173/

# --- Só para VITE_IDP=b2c ou external ---------------------------------------
# Só o subdomínio: `contoso`, não `contoso.onmicrosoft.com`.
VITE_TENANT_NAME=
# User flow do B2C, ex. B2C_1_susi. Não se aplica a external.
VITE_B2C_POLICY=

# --- Escopo pedido ao IdP ----------------------------------------------------
# Vazio = modo identidade (pede só openid/profile).
# API própria no B2C:  https://<tenant>.onmicrosoft.com/<app-id-uri>/<scope>
# Azure DevOps:        499b84ac-1321-427f-aa17-267ca6975798/.default
VITE_API_SCOPE=

# Organização do Azure DevOps, só se o alvo for o ADO.
VITE_ADO_ORG=


# -----------------------------------------------------------------------------
# App Flutter — lidas por scripts/rodar-app.sh e convertidas em --dart-define
# -----------------------------------------------------------------------------

# Onde a WebView carrega a SPA. Com `adb reverse tcp:5173 tcp:5173`, localhost
# do celular chega na sua máquina. Com túnel, use a URL https do túnel.
APP_SPA_BASE_URL=http://localhost:5173/

# Audience que o lado nativo aceita no token. Depende do que você pede:
#   modo identidade em workforce → 00000003-0000-0000-c000-000000000000 (Graph)
#   modo identidade em B2C       → o próprio VITE_CLIENT_ID
#   Azure DevOps                 → 499b84ac-1321-427f-aa17-267ca6975798
# Errou? O app mostra na tela qual audience chegou e qual valor usar.
APP_EXPECTED_AUDIENCE=<PREENCHER>

# Tenant esperado no claim `tid`. Vazio desliga a checagem.
APP_TENANT_ID=<PREENCHER>

# API que o lado nativo chama para provar que o token serve. Vazio desliga.
APP_PROBE_URL=https://graph.microsoft.com/v1.0/me

# User-Agent alternativo da WebView. Deixe VAZIO.
# Só preencha (ex. POCLogin/1.0) se estiver usando ngrok grátis e a página de
# aviso dele estiver atrapalhando o login. Ver README, "A página de aviso".
APP_WEBVIEW_USER_AGENT=
