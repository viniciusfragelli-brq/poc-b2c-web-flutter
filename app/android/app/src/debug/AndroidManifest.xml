<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Só no build de debug: libera HTTP puro para a WebView alcançar o Vite
         em http://localhost:5173 via `adb reverse`.

         Com targetSdk 28+ o Android bloqueia cleartext por padrão, e a WebView
         falha sem mensagem útil — tela branca. O manifest de release não recebe
         este atributo, então o app publicado continua só HTTPS. -->
    <application android:usesCleartextTraffic="true" />
</manifest>
